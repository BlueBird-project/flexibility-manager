FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FAST_API_CONFIG=/app/api/api_config.json

WORKDIR /app

# Needed by scipy/pandas wheels and common model dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

COPY api/main_inference app/api/main_inference.py
COPY api/fast_inference.py /app/api/fast_inference.py
COPY api/api_config.json /app/api/api_config.json
COPY forge /app/forge
COPY translate /app/translate

EXPOSE 8000

CMD ["uvicorn", "api.main_inference:app", "--host", "0.0.0.0", "--port", "8000"]
